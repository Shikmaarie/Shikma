# ---- Cardcom (סליקה) ----
# Terminal number and API user name from the Cardcom back office.
# Never commit the real values — set them in the hosting provider's env vars.
CARDCOM_TERMINAL=
CARDCOM_API_NAME=

# ---- Site ----
# Public origin. Used to build the URLs Cardcom redirects back to and the
# webhook URL it calls, so it must match the live domain exactly.
NEXT_PUBLIC_SITE_URL=https://rachelihadad.co.il

# ---- טופס רישום הילדים (/rishum) ----
# Password for /rishum/admin — viewing the registrations and downloading
# the Excel file. Without it the admin page stays closed.
REGISTRATIONS_ADMIN_PASSWORD=

# Where submissions are stored in production. Create a Vercel KV / Upstash
# Redis store and paste its REST credentials here; without them the form
# falls back to writing data/registrations.jsonl + data/registrations.xlsx
# on the local disk, which only survives outside serverless hosting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
